{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@app/auth(|/.*)$": "<rootDir>/../../../libs/auth/src/$1",
    "^@app/shared(|/.*)$": "<rootDir>/../../../libs/shared/src/$1",
    "^@app/shared/redis(|/.*)$": "<rootDir>/../../../libs/shared/redis/src/$1"
  }
}
